# Copy to .env and edit. NEVER commit .env.
NODE_ENV=development
PORT=3000
# Public URL of the site (used in sitemap, canonical links, Open Graph)
BASE_URL=http://localhost:3000
# SQLite database file (put it on a persistent disk/volume in production)
DATABASE_PATH=./data/hospital.db
# REQUIRED in production: long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=
# Set to 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare) so client IPs/HTTPS are read from X-Forwarded-* headers
TRUST_PROXY=0

# ---- SMS (optional). Leave SMS_PROVIDER=none until a real gateway is configured and tested. ----
# none    : SMS disabled. Events are recorded as "not_configured"; nothing is sent.
# console : DEVELOPMENT ONLY. Logs messages to the console; recorded as "simulated", never "delivered".
# http    : generic JSON-over-HTTPS gateway adapter (see docs/SMS.md)
SMS_PROVIDER=none
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=
# Shared secret the gateway must send in the X-Webhook-Secret header to the delivery-status callback (/api/sms/webhook)
SMS_WEBHOOK_SECRET=

# ---- EMAIL (optional). Notifications via Email ----
# none    : Email disabled. Events are recorded as "not_configured"; nothing is sent.
# console : DEVELOPMENT ONLY. Logs emails to the console; recorded as "simulated", never "delivered".
# http    : generic JSON-over-HTTPS gateway adapter (Resend, SendGrid, Mailgun, Brevo, custom API)
EMAIL_PROVIDER=none
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
EMAIL_FROM=SACHKHAND HOSPITAL <appointments@sachkhandhospital.org>
EMAIL_WEBHOOK_SECRET=

